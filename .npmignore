# tests & fixtures — never ship
test/
*.test.js
*.test.py
scripts/test_install*.py

# local data / auth / caches — never ship
data/
backtest-data/
coverage/
auth.json
token-cache.json
*.cookies.json
ranked-screen-rows.json
circuit-cache.json
lib/tennis-schedule-data/flashscore-cache.json
.propprofessor/

# scratch / dev-time scripts — never ship
scripts/scan-*
scripts/_scan-*
scripts/novig-scan.js
scripts/check-*

# generated/local documentation artifacts — never ship
docs/plans/
docs/cron-prompts/
docs/openapi.json
# NOTE: docs/STATUS.md is intentionally SHIPPED (curated content, linked from README).
# The docs/ subtree is governed by docs/.npmignore; a docs/STATUS.md rule here would
# be shadowed and silently ignored, so it is intentionally omitted.

# manual-only live diagnostic (scripts/live-smoke-all-tools.js) is excluded from the
# published package via a "!" negation in package.json's "files" array, because the
# "scripts/" allowlist entry supersedes .npmignore exact-path rules for tracked files.

# repo tooling & meta
hermes/
.hermes/
.github/
.git/
.gitignore
.eslintrc*
.eslintignore
.prettierrc*
.prettierignore
tsconfig.json
madge*
