{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "noResolve": true
  },
  "include": [
    "lib/propprofessor-lru-cache.js",
    "lib/propprofessor-redact.js",
    "lib/screen-ranker.js",
    "lib/screen-parser.js",
    "lib/propprofessor-risk-score.js",
    "lib/propprofessor-sharp-consensus.js",
    "lib/propprofessor-sharp-books.js",
    "lib/propprofessor-movement-disposition.js",
    "lib/propprofessor-api.js",
    "lib/propprofessor-auth.js",
    "lib/propprofessor-mcp-stdio.js",
    "lib/propprofessor-mcp-ranked-screen.js",
    "lib/response-envelope.js",
    "lib/mcp-arg-validator.js",
    "lib/league-presets.js",
    "lib/propprofessor-best-price.js",
    "lib/propprofessor-shared-utils.js",
    "lib/selection-matcher.js",
    "lib/selection-resolver.js",
    "lib/screen-summary.js",
    "lib/propprofessor-formatter.js"
  ]
}
