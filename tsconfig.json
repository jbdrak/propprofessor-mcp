{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "node16",
    "ignoreDeprecations": "5.0",
    "types": ["node"]
  },
  "include": ["lib/**/*.js"]
}
